  {
   "parameters": {
    "operation": "executeQuery",
    "query": "CREATE TABLE IF NOT EXISTS anmeldung_ba_campus (\n  matrikelnummer text PRIMARY KEY,\n  leistungspunkte integer NOT NULL,\n  praxissemester_anerkannt boolean NOT NULL\n);\nINSERT INTO anmeldung_ba_campus VALUES\n  ('11111', 215, true),\n  ('22222', 210, true),\n  ('33333', 190, false)\nON CONFLICT (matrikelnummer) DO NOTHING;",
    "options": {}
   },
   "id": "f5f543e8-5df0-4b92-ba9a-8c7694f31c2d",
   "name": "Mock anlegen",
   "type": "n8n-nodes-base.postgres",
