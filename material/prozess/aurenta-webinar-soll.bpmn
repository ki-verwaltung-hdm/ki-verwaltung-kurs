<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetischer Übungsfall Aurenta (HdM-Projekt Agentic AI für Growth Marketing, WS 2026/27). Keine Aussage über Zoi oder reale Kunden. Nur Semantik; das Diagramm-Layout ergänzt scripts/layout.mjs. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Webinar_Soll" targetNamespace="http://kirenz.de/process-lab" exporter="process-lab" exporterVersion="0.1">
  <bpmn:collaboration id="Collab_Webinar_Soll">
    <bpmn:participant id="Pool_Aurenta" name="Aurenta · Marketing (mit KI-Agent)" processRef="Prozess_Webinar_Soll" />
  </bpmn:collaboration>
  <bpmn:process id="Prozess_Webinar_Soll" name="Webinar-Nachbereitung (mit KI-Agent)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Webinar_Soll">
      <bpmn:lane id="Lane_Marketing" name="Marketing-Team">
        <bpmn:flowNodeRef>T_Pruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Freigabe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Senden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ende_Versendet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Nacharbeit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ende_Manuell</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="KI-Agent">
        <bpmn:flowNodeRef>T_Empfehlung</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Workflow-System (n8n, CRM)">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Lesen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Sperre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Erlaubt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ende_Gesperrt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Ablage</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Webinar beendet">
      <bpmn:documentation>Je Kontakt ein Lauf. Ausgelöst manuell nach dem Webinar.</bpmn:documentation>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_Lesen" name="Kontakt aus CRM lesen">
      <bpmn:documentation>Felder kontakt_id, rolle, unternehmen, webinar_status, anliegen, sprache, kontakt_erlaubt. Ein Kontakt pro Lauf.</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="T_Sperre" name="Kontaktfreigabe prüfen">
      <bpmn:documentation>Feste Regel vor jedem Modellschritt: nur kontakt_erlaubt = ja geht weiter. Kein Modellaufruf für gesperrte Kontakte.</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="G_Erlaubt" name="Kontakt erlaubt?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4_ja</bpmn:outgoing>
      <bpmn:outgoing>F4_nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Ende_Gesperrt" name="Gesperrt, kein Follow-up">
      <bpmn:documentation>Interne Ausgabe „kein_followup“, leerer Entwurf.</bpmn:documentation>
      <bpmn:incoming>F4_nein</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_Empfehlung" name="Anliegen einordnen, nächsten Schritt empfehlen und Entwurf erstellen">
      <bpmn:documentation>Modellschritt mit Fallpaket als Wissensgrundlage. Ausgabe strukturiert: entscheidung (erstgespraech, material, rueckfrage), begruendung, material_id, nachricht_entwurf (max. 120 Wörter), offene_punkte. Erfindet keine Links, Termine oder Leistungen.</bpmn:documentation>
      <bpmn:incoming>F4_ja</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Ablage" name="Ergebnis zur Prüfung ablegen">
      <bpmn:documentation>kontakt_id aus der Eingabe, freigabe = offen aus fester Logik. Kein Versand, keine CRM-Schreibaktion.</bpmn:documentation>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Pruefen" name="Empfehlung und Entwurf prüfen">
      <bpmn:documentation>Passt die Empfehlung zum Anliegen? Ist jede Leistungsangabe durch das Fallpaket gedeckt? Genau ein nächster Schritt?</bpmn:documentation>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Freigabe" name="Freigegeben?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F9_ja</bpmn:outgoing>
      <bpmn:outgoing>F9_nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_Senden" name="Follow-up versenden">
      <bpmn:documentation>Versand bleibt beim Menschen.</bpmn:documentation>
      <bpmn:incoming>F9_ja</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Ende_Versendet" name="Follow-up versendet">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_Nacharbeit" name="Manuell nachbearbeiten">
      <bpmn:documentation>Entwurf anpassen oder verwerfen. Befund für die Regelpflege notieren.</bpmn:documentation>
      <bpmn:incoming>F9_nein</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Ende_Manuell" name="Manuell erledigt">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_Lesen" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_Lesen" targetRef="T_Sperre" />
    <bpmn:sequenceFlow id="F3" sourceRef="T_Sperre" targetRef="G_Erlaubt" />
    <bpmn:sequenceFlow id="F4_ja" name="ja" sourceRef="G_Erlaubt" targetRef="T_Empfehlung" />
    <bpmn:sequenceFlow id="F4_nein" name="nein" sourceRef="G_Erlaubt" targetRef="Ende_Gesperrt" />
    <bpmn:sequenceFlow id="F5" sourceRef="T_Empfehlung" targetRef="T_Ablage" />
    <bpmn:sequenceFlow id="F6" sourceRef="T_Ablage" targetRef="T_Pruefen" />
    <bpmn:sequenceFlow id="F7" sourceRef="T_Pruefen" targetRef="G_Freigabe" />
    <bpmn:sequenceFlow id="F9_ja" name="ja" sourceRef="G_Freigabe" targetRef="T_Senden" />
    <bpmn:sequenceFlow id="F9_nein" name="nein" sourceRef="G_Freigabe" targetRef="T_Nacharbeit" />
    <bpmn:sequenceFlow id="F10" sourceRef="T_Nacharbeit" targetRef="Ende_Manuell" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_Senden" targetRef="Ende_Versendet" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_Webinar_Soll">
      <bpmndi:BPMNShape id="Pool_Aurenta_di" bpmnElement="Pool_Aurenta" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="2280" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Marketing_di" bpmnElement="Lane_Marketing" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="2250" height="280" />
